# ──────────────────────────────────────────────────────────────────────────────
# code-indexer environment configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Environment variables override .env file values.
# All settings have sensible defaults; only configure what you need.
# ──────────────────────────────────────────────────────────────────────────────


# ── Global ─────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_FORMAT=console          # json | console


# ── Parser ─────────────────────────────────────────────────────────────────────
PARSER_MAX_FILE_SIZE_BYTES=1048576          # 1 MB; increase for monorepos
PARSER_CONTEXT_LINES=3                      # context lines around each chunk


# ── Chunker ────────────────────────────────────────────────────────────────────
CHUNKER_STRATEGY=ast                        # ast | token | sliding_window
CHUNKER_CHUNK_SIZE=512                      # tokens (token) or chars (sliding_window)
CHUNKER_CHUNK_OVERLAP=64
CHUNKER_MIN_CHUNK_SIZE=20
CHUNKER_MAX_CHUNK_SIZE=2048


# ── Embeddings ─────────────────────────────────────────────────────────────────
# Choose one provider:

# Option A: Local (no API key, recommended for privacy)
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2           # 384 dims, fast
# EMBEDDING_MODEL=microsoft/codebert-base  # 768 dims, better for code
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64

# Option B: OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_OPENAI_API_KEY=sk-...
# EMBEDDING_BATCH_SIZE=256

# Option C: Ollama (local server)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_DIMENSIONS=768


# ── Vector Store ───────────────────────────────────────────────────────────────
# Choose one provider:

# Option A: ChromaDB (local, persistent, zero config)
VECTORSTORE_PROVIDER=chroma
VECTORSTORE_COLLECTION_NAME=code_index
VECTORSTORE_CHROMA_PERSIST_DIR=.chroma
VECTORSTORE_DISTANCE_METRIC=cosine

# Option B: Qdrant (production-grade, scalable)
# VECTORSTORE_PROVIDER=qdrant
# VECTORSTORE_QDRANT_URL=http://localhost:6333
# VECTORSTORE_QDRANT_API_KEY=          # leave blank for local Qdrant

# Option C: In-memory (testing / one-shot runs)
# VECTORSTORE_PROVIDER=in_memory


# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_LOG_LEVEL=info

# Bearer token auth (leave blank to disable)
API_KEY=

# CORS (comma-separated list of allowed origins)
# API_CORS_ORIGINS=["https://myapp.example.com"]
